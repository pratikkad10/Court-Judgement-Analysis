# Copy to .env. Required values are intentionally empty and must be set before a production start.
POSTGRES_DB=judgment_analyzer
POSTGRES_USER=judgment
POSTGRES_PASSWORD=change-this-local-password
JWT_SECRET=change-this-to-a-32-character-minimum-development-secret
INTERNAL_SERVICE_KEY=change-this-internal-service-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=500
# Current provider defaults were checked against each provider's public model/API documentation on 2026-10-12. Set only the keys you intend to use.
LLM_PROVIDER_ORDER=groq,gemini,nvidia,huggingface
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
HF_API_KEY=
HF_MODEL=openai/gpt-oss-120b:fastest
LLM_TIMEOUT_SECONDS=30
LLM_CIRCUIT_COOLDOWN_SECONDS=60
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RAG_MIN_SIMILARITY=0.30
# Test-only deterministic integration provider. Keep false outside automated tests.
TEST_FAKE_LLM=false
